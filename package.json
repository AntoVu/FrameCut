{
  "name": "framecut",
  "productName": "FrameCut",
  "version": "1.0.0",
  "description": "Fast video trimming with crop, zoom and resize",
  "main": "src/main.js",
  "author": "FrameCut",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "package": "electron-packager . FrameCut --platform=win32 --arch=x64 --asar --icon=build/icon.ico --extra-resource=ffmpeg --out=out --overwrite \"--ignore=^/(ffmpeg|build|out|node_modules)($|/)\""
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "@electron/packager": "^18.3.0"
  }
}
